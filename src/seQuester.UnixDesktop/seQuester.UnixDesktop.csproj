<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AssemblyName>RansomFree.UnixDesktop</AssemblyName><RootNamespace>RansomFree.UnixDesktop</RootNamespace>
    <TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <Version>0.9.2</Version><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyVersion>$(Version).0</AssemblyVersion><FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Title>seQuester Endpoint</Title>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../Assets/Branding/sequester-256.png" LogicalName="Quiver.seQuester.Icon" />
    <ProjectReference Include="../seQuester.Contracts/seQuester.Contracts.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
  </ItemGroup>
</Project>
