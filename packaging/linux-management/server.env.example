# systemd EnvironmentFile syntax, NOT a shell script. Never source this file.
# Install root-owned mode 0600. Replace placeholders before starting anything.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ASPNETCORE_URLS=https://127.0.0.1:7443
AllowedHosts=cptnycdc01;localhost;127.0.0.1
RF_ALLOW_LOOPBACK_HTTP=false
RF_DATA_DIR=/var/lib/ransomfree-management/data
RF_ADMIN_KEY=REPLACE_WITH_INDEPENDENT_64_HEX_SECRET

# Trusted server TLS certificate/private key. Supply PFX and password securely.
Kestrel__Certificates__Default__Path=/etc/ransomfree-management/tls/server.pfx
Kestrel__Certificates__Default__Password=REPLACE_SECURELY

# Separate encryption certificate/private key for persisted identity keys.
# Required by this deployment procedure on Linux; keep it for recovery.
IdentityKeys__CertificatePath=/etc/ransomfree-management/keys/identity.pfx
IdentityKeys__CertificatePassword=REPLACE_SECURELY

# SQLite is development-only here. No SQL host is contacted by this template.
Database__Provider=Sqlite
# For SQL Server: select SqlServer and supply a protected connection string.
# Database__ConnectionString="Server=tcp:SQL_HOST,1433;Database=RansomFree;User ID=REPLACE;Password=REPLACE;Encrypt=true;TrustServerCertificate=false;Persist Security Info=false"
# Optional Database__ManagementConnectionString / IdentityConnectionString /
# CallbackRegistryConnectionString / CallbackInboxConnectionString overrides.

# Receiver is a separate product service and is NOT included in this archive.
Callbacks__Enabled=false
RF_CALLBACK_DATA=/var/lib/ransomfree-management/callbacks
# Callbacks__Origin=https://RECEIVER_HOST
# Callbacks__DnsZone=CANARY_DNS_ZONE
# Callbacks__MailDomain=CANARY_MAIL_DOMAIN

PasswordPolicy__MinimumLength=14
PasswordPolicy__RequireUppercase=true
PasswordPolicy__RequireLowercase=true
PasswordPolicy__RequireDigit=true
PasswordPolicy__RequireSymbol=true
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning
# Email, client/server syslog and recipients are configured by administrators
# in the WebUI. No SMTP/syslog destination or credentials are supplied here.
