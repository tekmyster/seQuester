[Unit]
Description=Ransom Free Management Server (unsigned development)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3
ConditionPathExists=/etc/ransomfree-management/server.env

[Service]
Type=simple
User=rfmgmt
Group=rfmgmt
WorkingDirectory=/opt/ransomfree-management/current/app
ExecStart=/opt/ransomfree-management/current/app/RansomFree.Server
EnvironmentFile=/etc/ransomfree-management/server.env
Environment=HOME=/var/lib/ransomfree-management
Environment=TMPDIR=/run/ransomfree-management
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
StateDirectory=ransomfree-management
StateDirectoryMode=0700
LogsDirectory=ransomfree-management
LogsDirectoryMode=0700
RuntimeDirectory=ransomfree-management
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ransomfree-management
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
# MemoryDenyWriteExecute is intentionally omitted: .NET uses a JIT.

[Install]
WantedBy=multi-user.target
