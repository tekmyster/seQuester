<Project>
  <PropertyGroup>
    <SeQuesterApplication Condition="'$(MSBuildProjectName)' == 'RansomFree.DecoyHost'">true</SeQuesterApplication>
    <SeQuesterApplication Condition="'$(MSBuildProjectName)' == 'RansomFree' Or '$(MSBuildProjectName)' == 'RansomFree.Tray' Or '$(MSBuildProjectName)' == 'RansomFree.Agent' Or '$(MSBuildProjectName)' == 'RansomFree.Server' Or '$(MSBuildProjectName)' == 'RansomFree.Receiver' Or '$(MSBuildProjectName)' == 'RansomFree.LinuxAgent' Or '$(MSBuildProjectName)' == 'RansomFree.MacAgent' Or '$(MSBuildProjectName)' == 'RansomFree.UnixDesktop'">true</SeQuesterApplication>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SeQuesterApplication)' == 'true'">
    <ApplicationIcon>$(MSBuildThisFileDirectory)Assets/Branding/sequester.ico</ApplicationIcon>
    <Product>seQuester · Quiver</Product><Company>Quiver</Company>
  </PropertyGroup>
  <ItemGroup Condition="'$(SeQuesterApplication)' == 'true'">
    <Content Include="$(MSBuildThisFileDirectory)Assets/Branding/*" Link="Branding/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <SeQuesterBrandInput Include="$(MSBuildThisFileDirectory)Assets/Branding/sequester-256.png" ExpectedHash="EF71B9131B454D20EFEF21DAC8FC3CC1B81E7834240EC41DC5AB65AF2076D139" />
    <SeQuesterBrandInput Include="$(MSBuildThisFileDirectory)Assets/Branding/sequester.icns" ExpectedHash="C79D10FC312CBE22989CECABC126F8560E7C6C6EBB0DC4F8935B6958B80EB2B6" />
    <SeQuesterBrandInput Include="$(MSBuildThisFileDirectory)Assets/Branding/brand-assets.json" ExpectedHash="B39B0D1F4C48DC33BAB4EF4042FF5ABE9B45D5ED9314AB32EEF2F948EB004CFE" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'RansomFree.Server'">
    <SeQuesterBrandInput Include="wwwroot/brand/sequester.ico" ExpectedHash="26627790C3D1748B756751C1EEA6E3FF958A0D4F64B5A309AF3ED94BC2DFB7A1" />
    <SeQuesterBrandInput Include="wwwroot/brand/sequester-128.png" ExpectedHash="B7B01F1221F2FC2608821D3729475B9C06AD8CA2E588FC3AF18A656FAA5E6480" />
    <SeQuesterBrandInput Include="wwwroot/brand/sequester-180.png" ExpectedHash="6C6BC1CC822CF632246178A1475BCCCA19634A4AED085041EE67E8136341BA5B" />
    <SeQuesterBrandInput Include="wwwroot/brand/sequester-192.png" ExpectedHash="15E6119F4EA2A2363FF09F3CA81F7D9BB821130B5EC4CB3F3D0BBCD84E942AD7" />
    <SeQuesterBrandInput Include="wwwroot/brand/sequester-512.png" ExpectedHash="CFBEC6F4ED4A1F77C7C3A6AF403DCB08A4D67859D33777825EC88FA43D7DEE3C" />
  </ItemGroup>
  <Target Name="RequireCanonicalBrandAssets" BeforeTargets="CoreCompile" Condition="'$(SeQuesterApplication)' == 'true'">
    <Error Condition="!Exists('$(ApplicationIcon)')" Text="Canonical seQuester application icon is missing. Run the reviewed brand asset builder; do not substitute a default icon." />
    <GetFileHash Files="$(ApplicationIcon)" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="SeQuesterIconHash" /></GetFileHash>
    <Error Condition="'%(SeQuesterIconHash.FileHash)' != '26627790C3D1748B756751C1EEA6E3FF958A0D4F64B5A309AF3ED94BC2DFB7A1'" Text="Application icon differs from the reviewed canonical-derived asset." />
    <GetFileHash Files="@(SeQuesterBrandInput)" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="SeQuesterBrandHash" /></GetFileHash>
    <Error Condition="'%(SeQuesterBrandHash.FileHash)' != '%(SeQuesterBrandHash.ExpectedHash)'" Text="Branded application resource differs from the reviewed canonical-derived asset." />
  </Target>
</Project>
